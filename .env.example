NODE_ENV=development
PORT=3000

# Database
# For Docker: use 'db' as host
# For local development: use 'localhost' as host
DATABASE_URL=postgres://postgres:postgres@localhost:5432/creatorsfy

# Shopify OAuth
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders
SHOPIFY_API_VERSION=2023-10
HOST=https://<ngrok-url>
